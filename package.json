    "build:dev": "npm run clean && cross-env EVN_FILE_NAME=dev next build",
    "clean": "rimraf .next out",
    "lint": "next lint && npm run typecheck",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prettier": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}'",
    "test": "node --test src/",
    "sync": "node scripts/sync-from-fe-interface.js",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "i18n": "npm run i18n:extract && npm run i18n:compile"
  },
  "resolutions": {
